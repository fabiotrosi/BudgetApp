@model List<BudgetIndexRowViewModel>
@{
    ViewData["Title"] = "Budgets";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Budgets</h2>
    <a asp-action="Create" class="btn btn-primary">
        <span class="me-2">Lagerbudget erstellen</span>
        <i class="bi bi-plus-square"></i>
    </a>
</div>
<hr />

@if (!Model.Any())
{
    <p class="text-muted">Noch keine Budgets vorhanden. <a asp-action="Create">Jetzt erstellen.</a></p>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Budget</th>
                <th>Zeitraum</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model)
            {
                var budget = row.Budget;
                <tr>
                    <td>
                        <strong>@budget.Name</strong>
                        @if (!string.IsNullOrEmpty(budget.Description))
                        {
                            <br /><small class="text-muted">@budget.Description</small>
                        }
                    </td>
                    <td>
                        @($"{budget.StartDate:dd.MM.yyyy} – {budget.EndDate:dd.MM.yyyy}")
                    </td>
                    <td class="text-end text-nowrap">
                        <button type="button" class="btn btn-sm btn-outline-primary" title="Ausgabe erfassen"
                                onclick="openCreateTransactionModal(@budget.Id)">
                            <i class="bi bi-cash-coin"></i>
                        </button>
                        @if (row.IsMainLeader)
                        {
                            <a asp-controller="Transaction" asp-action="BudgetOverview" asp-route-budgetId="@budget.Id" class="btn btn-sm btn-outline-secondary" title="Ausgabenübersicht">
                                <i class="bi bi-receipt"></i>
                            </a>
                        }
                        <a asp-action="Detail" asp-route-id="@budget.Id" class="btn btn-sm btn-outline-secondary" title="Anzeigen">
                            <i class="bi bi-eye"></i>
                        </a>
                        
                        @if (row.IsMainLeader)
                        {
                            <a asp-action="Edit" asp-route-id="@budget.Id" class="btn btn-sm btn-outline-secondary" title="Lagerdaten bearbeiten">
                                <i class="bi bi-pen"></i>
                            </a>
                        }
                        <a asp-action="Leaders" asp-route-id="@budget.Id" class="btn btn-sm btn-outline-secondary" title="@(row.IsMainLeader ? "Leitpersonen verwalten" : "Leitpersonen anzeigen")">
                            <i class="bi bi-people"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div id="createTransactionModalContainer"></div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
