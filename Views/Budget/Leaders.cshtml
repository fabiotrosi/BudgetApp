@model BudgetLeadersViewModel
@using BudgetApp.Enums
@{
    ViewData["Title"] = "Leitpersonen – " + Model.Budget.Name;
}

<div class="d-flex justify-content-between align-items-start mb-2">
    <div>
        <h2>Leitpersonen</h2>
        <small class="text-muted">@Model.Budget.Name</small>
    </div>
    <partial name="_GoBackButton" />
</div>
<hr />

<div class="mb-4">
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Name</th>
                <th>E-Mail</th>
                <th>Rolle</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var member in Model.BudgetUsers)
            {
                <tr class="@(!member.IsActive ? "text-muted" : "")">
                    <td>@member.DisplayName</td>
                    <td>@member.Email</td>
                    <td>
                        @if (member.IsMainLeader)
                        {
                            <span class="badge bg-primary">Hauptleitperson</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Leitperson</span>
                        }
                        @if (!member.IsActive)
                        {
                            <span class="badge bg-secondary">Deaktiviert</span>
                        }
                    </td>
                    <td class="text-end">
                        @if (Model.IsMainLeader && !member.IsMainLeader && member.IsActive)
                        {
                            <form asp-controller="Budget" asp-action="DeactivateBudgetUser" method="post" class="d-inline"
                                  onsubmit="return confirm('Leitperson wirklich deaktivieren?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="budgetUserId" value="@member.Id" />
                                <input type="hidden" name="budgetId" value="@Model.Budget.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-person-dash"></i>
                                </button>
                            </form>
                        }
                        else if (Model.IsMainLeader && !member.IsMainLeader && !member.IsActive)
                        {
                            <form asp-controller="Budget" asp-action="ReactivateBudgetUser" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="budgetUserId" value="@member.Id" />
                                <input type="hidden" name="budgetId" value="@Model.Budget.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-primary">
                                    Reaktivieren <i class="bi bi-arrow-repeat"></i>
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.IsMainLeader && Model.Invites.Any())
    {
        <h6 class="mt-3">Einladungen</h6>
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Leitperson</th>
                    <th>E-Mail</th>
                    <th>Eingeladen durch</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (BudgetInviteModel invite in Model.Invites)
                {
                    <tr>
                        <td>@invite.InvitedUserDisplayName</td>
                        <td>@invite.InvitedUserEmail</td>
                        <td>@invite.InvitedByDisplayName</td>
                        <td>
                            @switch (invite.Status)
                            {
                                case InviteStatus.Pending:
                                    <span class="badge bg-warning text-dark">Ausstehend</span>
                                    break;
                                case InviteStatus.Accepted:
                                    <span class="badge bg-success">Angenommen</span>
                                    break;
                                case InviteStatus.Declined:
                                    <span class="badge bg-secondary">Abgelehnt</span>
                                    break;
                            }
                            @if (
                                invite.Status == InviteStatus.Accepted
                                && Model.BudgetUsers.Any(bu =>
                                    bu.UserId == invite.InvitedUserId && !bu.IsActive
                                )
                            )
                            {
                                <span class="badge bg-secondary">Deaktiviert</span>
                            }
                        </td>
                        <td>
                            @if (invite.Status == InviteStatus.Declined)
                            {
                                <form asp-controller="Invite" asp-action="Reinvite" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@invite.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary">
                                        Erneut einladen <i class="bi bi-arrow-repeat"></i>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (Model.IsMainLeader)
    {
        <button type="button" class="btn btn-outline-primary mt-3" onclick="openInviteLeaderModal(@Model.Budget.Id)">
            Leitperson einladen <i class="bi bi-envelope-plus"></i>
        </button>
        <div id="inviteLeaderModalContainer"></div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
