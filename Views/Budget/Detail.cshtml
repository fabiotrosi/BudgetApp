@model BudgetDetailViewModel
@using BudgetApp.Enums
@{
    ViewData["Title"] = Model.Budget.Name;

    string QvarLabel(string? varName) => varName switch
    {
        "ParticipantsCount_fc" => "Teilnehmer",
        "js_PersonsCount_fc"   => "J+S Pers.",
        "LeadersTeamCount_fc"  => "Leitungsteam",
        "ParticipantsCount_rl" => "Teilnehmer",
        "js_PersonsCount_rl"   => "J+S Pers.",
        "LeadersTeamCount_rl"  => "Leitungsteam",
        _                      => varName ?? string.Empty
    };
}

<div class="d-flex justify-content-between align-items-start mb-2">
    <div>
        <h2>@Model.Budget.Name</h2>
        @if (!string.IsNullOrEmpty(Model.Budget.Description))
        {
            <p class="text-muted mb-1">@Model.Budget.Description</p>
        }
        <small class="text-muted">
            Lager: @Model.Budget.StartDate.ToString("dd.MM.yyyy") – @Model.Budget.EndDate.ToString("dd.MM.yyyy")
            @{
                var mainLeader = Model.BudgetUsers.FirstOrDefault(bu => bu.IsMainLeader);
            }
            @if (mainLeader != null)
            {
                <span> | Hauptleitperson: @mainLeader.DisplayName</span>
            }
        </small>
        @if (Model.BudgetUsers.Count > 1)
        {
            <div class="mt-1">
                @foreach (var bu in Model.BudgetUsers)
                {
                    <span class="badge @(bu.IsMainLeader ? "bg-primary" : "bg-secondary") me-1">@bu.DisplayName</span>
                }
            </div>
        }
    </div>
    <div class="d-flex gap-2 flex-wrap">
        @if (Model.IsMainLeader)
        {
            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#budgetAddPositionModal">
                Position hinzufügen <i class="bi bi-plus-square"></i>
            </button>
        }
        <button type="button" class="btn btn-outline-primary btn-sm" onclick="openCreateTransactionModal(@Model.Budget.Id)">
            Ausgabe erfassen <i class="bi bi-cash-coin"></i>
        </button>
        @if (Model.IsMainLeader)
        {
            <a asp-action="Edit" asp-route-id="@Model.Budget.Id" class="btn btn-outline-secondary btn-sm">
                Lagerdaten bearbeiten <i class="bi bi-pen"></i>
            </a>
        }
        <a asp-action="Leaders" asp-route-id="@Model.Budget.Id" class="btn btn-outline-secondary btn-sm">
            @(Model.IsMainLeader ? "Leitpersonen verwalten" : "Leitpersonen anzeigen") <i class="bi bi-people"></i>
        </a>
        @if (Model.IsMainLeader)
        {
            <a asp-controller="Transaction" asp-action="BudgetOverview" asp-route-budgetId="@Model.Budget.Id" class="btn btn-outline-secondary btn-sm">
                Ausgabenübersicht <i class="bi bi-receipt"></i>
            </a>
        }
        <partial name="_GoBackButton" />
    </div>
</div>
<hr />

@if (Model.Groups.Any())
{
    @foreach (var catGroup in Model.Groups)
    {
        <h4 class="mt-4">@catGroup.Category.Name</h4>

        <table class="table table-sm table-bordered mb-2">
            <thead class="table-light">
                <tr>
                    <th colspan="5" class="fw-normal fst-italic text-center w-50">Provisorisch</th>
                    <th colspan="5" class="fw-normal fst-italic text-center w-50">Definitiv</th>
                </tr>
                <tr>
                    <th>Position</th>
                    <th class="text-end">Fixbetrag</th>
                    <th class="text-end">Anzahl</th>
                    <th class="text-end">Einheitspreis</th>
                    <th class="text-end">Total</th>
                    <th class="text-end">Fixbetrag</th>
                    <th class="text-end">Anzahl</th>
                    <th class="text-end">Einheitspreis</th>
                    <th class="text-end">Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var subGroup in catGroup.SubGroups)
                {
                    @if (subGroup.SubCategory != null)
                    {
                        <tr class="table-secondary">
                            <td colspan="10" class="fw-semibold py-1">@subGroup.SubCategory.Name</td>
                        </tr>
                    }
                    @foreach (var pos in subGroup.Positions)
                    {
                        <tr class="@(pos.IsIncome ? "table-success" : "table-danger")">
                            <td class="@(subGroup.SubCategory != null ? "ps-3" : "")">@pos.Name</td>
                            <td class="text-end">CHF @pos.FixedAmount_fc.ToString("N2")</td>
                            <td class="text-end">
                                @if (pos.QuantityVar_fc != null)
                                {
                                    <span class="badge bg-info text-dark" title="Variable: @pos.QuantityVar_fc">@QvarLabel(pos.QuantityVar_fc) (@pos.Quantity_fc.ToString("N0"))</span>
                                }
                                else
                                {
                                    @pos.Quantity_fc.ToString("N0")
                                }
                            </td>
                            <td class="text-end">CHF @pos.UnitAmount_fc.ToString("N2")</td>
                            <td class="text-end fw-semibold">CHF @pos.TotalAmount_fc.ToString("N2")</td>
                            <td class="text-end">@(pos.FixedAmount_rl == null ? "–" : "CHF " + pos.FixedAmount_rl.Value.ToString("N2"))</td>
                            <td class="text-end">
                                @if (pos.QuantityVar_rl != null)
                                {
                                    <span class="badge bg-info text-dark" title="Variable: @pos.QuantityVar_rl">@QvarLabel(pos.QuantityVar_rl) (@pos.Quantity_rl?.ToString("N0"))</span>
                                }
                                else
                                {
                                    @(pos.Quantity_rl?.ToString("N0") ?? "–")
                                }
                            </td>
                            <td class="text-end">@(pos.UnitAmount_rl == null ? "–" : "CHF " + pos.UnitAmount_rl.Value.ToString("N2"))</td>
                            <td class="text-end fw-semibold">CHF @pos.TotalAmount_rl.ToString("N2")</td>
                            <td class="text-end text-nowrap">
                                @if (Model.IsMainLeader)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary"
                                            onclick="openEditPositionModal(@pos.Id)">
                                        <i class="bi bi-pen"></i>
                                    </button>
                                    <form asp-action="DeleteBudgetPosition" method="post" class="d-inline"
                                          onsubmit="return confirm('Position «@pos.Name» wirklich löschen?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@pos.Id" />
                                        <input type="hidden" name="budgetId" value="@Model.Budget.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    <tr class="table-light border-top border-secondary border-opacity-25">
                        <td colspan="4" class="fw-bold">Total @(subGroup.SubCategory?.Name ?? "übrige Positionen")</td>
                        <td class="text-end @(subGroup.TotalAmount_fc >= 0 ? "text-success" : "text-danger")">CHF @subGroup.TotalAmount_fc.ToString("N2")</td>
                        <td colspan="3"></td>
                        <td class="text-end @(subGroup.TotalAmount_rl >= 0 ? "text-success" : "text-danger")">CHF @subGroup.TotalAmount_rl.ToString("N2")</td>
                        <td></td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="table-secondary">
                    <td colspan="4" class="fw-bold">Total @catGroup.Category.Name</td>
                    <td class="fw-bold text-end @(catGroup.TotalAmount_fc >= 0 ? "text-success" : "text-danger")">CHF @catGroup.TotalAmount_fc.ToString("N2")</td>
                    <td colspan="3"></td>
                    <td class="fw-bold text-end @(catGroup.TotalAmount_rl >= 0 ? "text-success" : "text-danger")">CHF @catGroup.TotalAmount_rl.ToString("N2")</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    }

    <div class="card mt-4">
        <div class="card-body">
            <h5 class="card-title mb-3">Gesamttotal</h5>
            <div class="row mb-1">
                <div class="col-md-6 fst-italic">Provisorisch</div>
                <div class="col-md-6 fst-italic">Definitiv</div>
            </div>
            <hr class="my-2" />
            <div class="row mb-1">
                <div class="col-6 col-md-3">Einnahmen</div>
                <div class="col-6 col-md-3 text-success text-end">CHF @Model.TotalIncome_fc.ToString("N2")</div>
                <div class="col-6 col-md-3">Einnahmen</div>
                <div class="col-6 col-md-3 text-success text-end">CHF @Model.TotalIncome_rl.ToString("N2")</div>
            </div>
            <div class="row mb-1">
                <div class="col-6 col-md-3">Ausgaben</div>
                <div class="col-6 col-md-3 text-danger text-end">CHF @Model.TotalExpenses_fc.ToString("N2")</div>
                <div class="col-6 col-md-3">Ausgaben</div>
                <div class="col-6 col-md-3 text-danger text-end">CHF @Model.TotalExpenses_rl.ToString("N2")</div>
            </div>
            <hr class="my-2" />
            <div class="row">
                <div class="col-6 col-md-3 fw-bold">Saldo</div>
                <div class="col-6 col-md-3 text-end fw-bold @(Model.TotalAmount_fc >= 0 ? "text-success" : "text-danger")">CHF @Model.TotalAmount_fc.ToString("N2")</div>
                <div class="col-6 col-md-3 fw-bold">Saldo</div>
                <div class="col-6 col-md-3 text-end fw-bold @(Model.TotalAmount_rl >= 0 ? "text-success" : "text-danger")">CHF @Model.TotalAmount_rl.ToString("N2")</div>
            </div>
        </div>
    </div>
}
else
{
    <p class="text-muted">Keine Positionen vorhanden.</p>
}

<div id="editPositionModalContainer"></div>
<div id="createTransactionModalContainer"></div>

<script>
    function openEditPositionModal(id) {
        fetch('@Url.Action("EditPositionModal", "Budget")?id=' + id + '&budgetId=@Model.Budget.Id')
            .then(r => r.text())
            .then(html => {
                const container = document.getElementById('editPositionModalContainer');
                container.innerHTML = html;
                initCurrencyInputs(container);
                initCountInputs(container);
                new bootstrap.Modal(container.querySelector('.modal')).show();
            });
    }
</script>

@if (Model.IsMainLeader)
{
    @await Html.PartialAsync("_AddPosition", new AddPositionPartialViewModel
    {
        ModalId = "budgetAddPositionModal",
        FormAction = "AddBudgetPosition",
        FormController = "Budget",
        ParentIdFieldName = "BudgetId",
        ParentId = Model.Budget.Id,
        CategorySelectId = "budgetAddCategoryId",
        SubCategorySelectId = "budgetAddSubCategoryId",
        PositionTypes = Model.PositionTypes,
        Categories = Model.AllCategories,
        SubCategories = Model.AllSubCategories,
        ShowCampVariables = true,
        CampParticipantsCount_fc = Model.Budget.ParticipantsCount_fc,
        CampJs_PersonsCount_fc = Model.Budget.js_PersonsCount_fc,
        CampLeadersTeamCount_fc = Model.Budget.LeadersTeamCount_fc
    })
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

