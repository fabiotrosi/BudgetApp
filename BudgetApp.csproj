<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="NLog.Web.AspNetCore" Version="6.2.1" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\DataAnnotations.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>DataAnnotations.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\DataAnnotations.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>DataAnnotations.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <!--
    Local development relies on the SQL Server container from docker-compose.yml.
    Start it automatically before every Debug build (dotnet build/run/watch, and IDE F5,
    all invoke the Build target) so the app doesn't throw a DB connection exception just
    because the container wasn't started manually first. `docker compose up -d` is a no-op
    if the container is already running. Skipped for design-time builds (IntelliSense),
    non-Debug configurations (e.g. CI/publish), and inside Codespaces, where the devcontainer
    already starts the DB itself. Failures are only a warning so builds still work without
    Docker installed/running.
  -->
  <Target
    Name="StartDockerCompose"
    BeforeTargets="Build"
    Condition="'$(Configuration)' == 'Debug' AND '$(DesignTimeBuild)' != 'true' AND '$(BuildingProject)' == 'true' AND '$(CODESPACES)' == ''"
  >
    <Exec
      Command="docker compose up -d"
      ContinueOnError="WarnAndContinue"
      StandardOutputImportance="low"
    />
  </Target>
</Project>
